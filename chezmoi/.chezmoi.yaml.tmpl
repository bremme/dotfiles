
{{- $roles := list "server" "workstation" -}}

sourceDir: {{ .chezmoi.config.sourceDir }}

data:
  role: {{ promptChoice "Machine role(s/w)" $roles "server" | quote }}
  work: {{ promptBool "Work account?(y/n)" false }}
  gitUserName: {{ promptString "Git user name" "bremme" | quote }}
  gitUserEmail: {{ promptString "Git user email" "mail@example.com" | quote }}