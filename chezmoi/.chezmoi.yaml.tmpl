
{{- $roles := list "edge" "server" "workstation" -}}

sourceDir: {{ .chezmoi.config.sourceDir }}

data:
  role: {{ promptChoiceOnce . "role" "Machine role(s/w)" $roles "server" | quote }}
  work: {{ promptBoolOnce . "work" "Work account?(y/n)" false }}
  gitName: {{ promptStringOnce . "gitName" "Git user name" "bremme" | quote }}
  gitEmail: {{ promptStringOnce . "gitEmail" "Git user email" "6715707+bremme@users.noreply.github.com" | quote }}