#!/usr/bin/env bash
set -euo pipefail

# Package inventory hash: {{ include ".chezmoidata.yaml" | sha256sum }}

{{- if eq .chezmoi.os "darwin" }}
# handle macOS case

brew bundle --file "$HOME/.dotfiles.Brewfile"

{{- else if and (eq .chezmoi.os "linux") (or (eq .chezmoi.arch "amd64") (eq .chezmoi.arch "arm64")) }}
# handle linux amd64 and arm64 case

mise install --yes

{{- else if and (eq .chezmoi.os "linux") (contains "debian" .chezmoi.osRelease.idLike) }}
# handle unsupported architecture for Debian-based Linux
printf "Unsupported architecture, try apt install fallback\n"

sudo apt update
apt_packages=(
{{- range $package := .packages }}
{{- if and $package.apt (has $.role $package.roles) }}
	"{{ $package.apt }}"
{{- end }}
{{- end }}
)
sudo apt install -y "${apt_packages[@]}"

{{- else }}

printf "Unsupported system, try manual installation\n"
exit 1
{{- end}}