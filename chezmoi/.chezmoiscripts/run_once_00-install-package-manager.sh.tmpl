#!/usr/bin/env bash
set -euo pipefail

# MacOS: Install Homebrew to manage and install shell tools
{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew &> /dev/null; then
  echo "Installing Homebrew to manage and install shell tools..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
else
  echo "brew already installed."
fi

# Linux: Install Mise to manage and install shell tools
{{ else if eq .chezmoi.os "linux" -}}
if ! command -v mise &> /dev/null; then
  echo "Installing Mise to manage and install shell tools..."
  curl -fsSL https://mise.run | sh
else
  echo "Mise already installed."
fi
{{ end -}}